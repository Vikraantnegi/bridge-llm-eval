{
  "name": "bridge-llm-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KAN-83 operator quality judge — offline batch scorer.",
  "scripts": {
    "check:mirror": "node scripts/check-run-results-mirror.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "score:batch": "tsx cli/scoreBatch.ts",
    "score:batch:dev": "tsx cli/scoreBatch.ts --env dev --since 24",
    "score:batch:prod": "tsx cli/scoreBatch.ts --env prod --since 24",
    "calibrate:check": "tsx cli/calibrationCheck.ts"
  },
  "dependencies": {
    "dotenv": "^16"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
